# MMA ProSync — Environment Variables
NODE_ENV=development

# PostgreSQL connection — pilih salah satu:
# Opsi 1: full connection string (rekomendasi)
DATABASE_URL=postgresql://mma_admin:mma_prosync_2024!@127.0.0.1:5432/mma_prosync

# Opsi 2: parameter terpisah (fallback kalau DATABASE_URL kosong)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mma_prosync
DB_USER=mma_admin
DB_PASSWORD=mma_prosync_2024!

# Default toko (UUID user/toko pertama)
DEFAULT_TOKO_ID=a0a0a0a0-0000-0000-0000-000000000001
